# Flask configuration
FLASK_APP=app:create_app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database configuration (defaults to SQLite instance/cinebook.db if not provided)
DATABASE_URL=sqlite:///cinebook.db

# MongoDB Big-Data & Analytics layer configuration
# Local Docker: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cinebook_analytics
